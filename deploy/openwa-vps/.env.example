# OpenWA / Unique Market
# Copy this file to .env on the VPS. Never commit the real values.

# Public origin of the OpenWA dashboard/API.
CORS_ORIGINS=https://wa.unique-market.example

# Optional rate limiting overrides.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
BODY_SIZE_LIMIT=2mb

# After first boot, OpenWA creates its initial admin API key inside /app/data/.api-key.
# Do NOT put that key in Git.
